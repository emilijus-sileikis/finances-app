{
  "expo": {
    "name": "Finances",
    "slug": "finances",
    "scheme": "finances",
    "version": "1.5.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#090E1A",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0F1827"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.emilijussileikis.finances"
    },
    "android": {
      "package": "com.emilijussileikis.finances",
      "adaptiveIcon": {
        "backgroundColor": "#0F1827",
        "foregroundImage": "./assets/android-icon-foreground.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-sqlite",
      "expo-sharing",
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Finances to pick receipt and tax photos from your gallery.",
          "cameraPermission": "Allow Finances to take photos of receipts and tax documents."
        }
      ],
      [
        "expo-share-intent",
        {
          "disableIOS": true,
          "androidIntentFilters": ["image/*", "application/pdf", "text/*"]
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Allow Finances to unlock with Face ID."
        }
      ]
    ],
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "bb120991-74dc-455c-9d20-6b230ac3c2e2"
      }
    }
  }
}
